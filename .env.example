# MEXC API Configuration
MEXC_BASE_URL=https://api.mexc.com
VENUE=MEXC

# Trading Mode
MODE=SIM
SIM_EQUITY_START=500
LIVE_EQUITY_START=0
MARKET_TYPE=FUTURES

# ============================================================
# FUTURES & SHORTS CONFIG (V4.2 SAFE_BULL)
# ============================================================
ENABLE_FUTURES=true
ENABLE_SHORTS_IN_BULL=false
ENABLE_SHORTS_IN_SIDEWAYS=true
ENABLE_SHORTS_IN_MILD_BEAR=true
ENABLE_SHORTS_IN_DEEP_BEAR=true
MAX_FUNDING_8H_SHORT=0.00035

# Risk per trade - LONGS (by regime)
RISK_PER_TRADE_BULL=0.0025
RISK_PER_TRADE_SIDEWAYS=0.0025
RISK_PER_TRADE_MILD_BEAR=0.0018
RISK_PER_TRADE_DEEP_BEAR=0.0015
RISK_PER_TRADE_BEAR_LONG=0.0010
ENABLE_BEAR_LONGS=true

# Risk per trade - SHORTS (by regime)
RISK_PER_TRADE_SIDEWAYS_SHORT=0.0015
RISK_PER_TRADE_MILD_BEAR_SHORT=0.0015
RISK_PER_TRADE_DEEP_BEAR_SHORT=0.0012

# Portfolio Limits
MAX_PORTFOLIO_HEAT=0.015
MAX_CONCURRENT_POSITIONS=5

# Signal thresholds
MIN_24H_QUOTE_VOLUME=50000
MAX_ALLOWED_SPREAD_PCT=1.1
MIN_RVOL_15M_BULL=1.15
MIN_RVOL_15M_BEAR_SHORT=1.25

# ============================================================
# LEGACY / GENERAL RISK
# ============================================================
MAX_DAILY_DRAWDOWN_PCT=2.0
MAX_POSITION_RISK_PCT=0.5
MIN_LIQUIDITY_VOLUME_24H=100000
MAX_CORRELATED_POSITIONS=2
TRADING_PAUSED=false

# Position Management
MAX_CONCURRENT_POS=5
MAX_PER_TRADE_PCT=20.0
STOP_LOSS_PCT=5.0
TAKE_PROFIT_PCT=10.0

# Exit Strategy
USE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION_PCT=2.0
TRAILING_STOP_DISTANCE_PCT=1.0
MAX_HOLD_TIME_HOURS=24

# Fees & Slippage
MAKER_FEE_PCT=0.0
TAKER_FEE_PCT=0.1
SLIPPAGE_PCT=0.05

# Signal Configuration
MIN_SIGNAL_SCORE=80
SYMBOL_COOLDOWN_HOURS=6
CHECK_ORDER_BOOK_IMBALANCE=true
MOON_SCORE=90
MOON_MULT=1.5

# Self-Learning
LEARNING_ENABLED=true
MIN_TRADES_FOR_LEARNING=30
MAX_WEIGHT_CHANGE_PCT=15
LEARNING_LOOKBACK_DAYS=30

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ALERT_ON_DRAWDOWN_PCT=3.0
ALERT_ON_WEIGHT_CHANGE_PCT=10.0
DAILY_REPORT_HOUR=9

# Scheduler Intervals (seconds)
SCANNER_INTERVAL=300
TRADER_INTERVAL=60
LEARNING_INTERVAL=3600
